#!/bin/bash
#---------------------------------------------------------------
# NCSA Delta -- CPU partition environment for GACODE
#
# Delta moved to RedHat 9 in 2025 and its programming environment is
# now the HPE Cray PE (as on DeltaAI), NOT the old Spack/modtree stack:
#
#   PrgEnv-gnu + gcc-native   compiler (Cray wrappers cc/CC/ftn)
#   cray-mpich                the ONLY supported MPI (no mpirun; use srun)
#   cray-libsci               BLAS/LAPACK/ScaLAPACK
#   cray-fftw                 FFTW3 (single + double, threaded)
#
# The retired modules 'modtree/cpu', 'gcc/<ver>', 'openmpi/<ver>' and
# 'openblas/<ver>' no longer exist and Lmod reports them as unknown.
# Versions are deliberately NOT pinned here: 'module reset' loads the
# site default set, which is what NCSA supports.
#
# NOTE: gacode_setup does NOT source this file.  Source it explicitly
#       before building, and from inside every batch job (both
#       qsub.DELTA_CPU and job_scripts/submit_cgyro_delta.sh do).
#---------------------------------------------------------------

if [ -n "$SSH_TTY" ] ; then
   echo "Setting up $GACODE_PLATFORM environment for gacode"
fi

# Lmod is not initialised in non-login shells (e.g. an sbatch script
# without '-l').  Bootstrap it if 'module' is missing.
if ! command -v module > /dev/null 2>&1 ; then
   for f in /etc/profile.d/z00_lmod.sh /etc/profile.d/lmod.sh /etc/profile.d/modules.sh ; do
      [ -f "$f" ] && . "$f" && break
   done
fi

# 'module reset' restores Delta's default set (PrgEnv-gnu, gcc-native,
# craype, cray-mpich, cray-libsci, craype-x86-milan, cudatoolkit,
# craype-accel-nvidia80) and also defines $WORK and $SCRATCH.
module reset

# Re-assert the pieces we depend on; harmless when already loaded, and
# it keeps the platform working if the site default PE ever changes.
module load PrgEnv-gnu    || echo "WARNING: (env.DELTA_CPU) PrgEnv-gnu not available"
module load craype-x86-milan || echo "WARNING: (env.DELTA_CPU) craype-x86-milan not available"
module load cray-libsci   || echo "WARNING: (env.DELTA_CPU) cray-libsci not available"
module load cray-fftw     || echo "WARNING: (env.DELTA_CPU) cray-fftw not available -- try 'module spider fftw'"

# CPU-only build: drop the GPU-offload target so nothing tries to link
# libmpi_gtl_cuda, and tell cray-mpich no GPU buffers are coming.
module unload craype-accel-nvidia80 2> /dev/null || true
export MPICH_GPU_SUPPORT_ENABLED=0

# Only needed to build profiles_gen/tgyro (see NETCDF in make.inc.DELTA_CPU):
#module load cray-hdf5 cray-netcdf

#---------------------------------------------------------------
# OpenMP defaults (per-run OMP_NUM_THREADS is set by exec.DELTA_CPU)
#---------------------------------------------------------------
export OMP_STACKSIZE=400M
export OMP_PLACES=cores
export OMP_PROC_BIND=close

# Large automatic arrays in cgyro; raise the stack limit where allowed.
ulimit -s unlimited 2> /dev/null || true
