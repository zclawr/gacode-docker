#!/bin/bash
#---------------------------------------------------------------
# NCSA Delta -- CPU partition environment for GACODE
# GNU 11.4.0 + OpenMPI 4.1.6 + OpenBLAS 0.3.25 + FFTW 3.3.10
#
# NOTE: gacode_setup does NOT source this file.  Source it explicitly
#       before building, and from inside every batch job (both
#       qsub.DELTA_CPU and job_scripts/submit_cgyro_delta.sh do).
#---------------------------------------------------------------

if [ -n "$SSH_TTY" ] ; then
   echo "Setting up $GACODE_PLATFORM environment for gacode"
fi

# Lmod is not initialised in non-login shells (e.g. an sbatch script
# without '-l').  Bootstrap it if 'module' is missing.
if ! command -v module > /dev/null 2>&1 ; then
   for f in /etc/profile.d/z00_lmod.sh /etc/profile.d/lmod.sh /etc/profile.d/modules.sh ; do
      [ -f "$f" ] && . "$f" && break
   done
fi

# modtree/cpu selects the CPU-side Lmod tree; load it before the
# compiler so the hierarchy resolves to the CPU builds.
module reset
module load modtree/cpu
module load gcc/11.4.0
module load openmpi/4.1.6
module load fftw/3.3.10
module load openblas/0.3.25

# netlib-lapack is intentionally not loaded: OpenBLAS provides LAPACK.
# Only needed to build profiles_gen (see NETCDF in make.inc.DELTA_CPU):
#module load hdf5/1.14.3 netcdf-c/4.9.2 netcdf-fortran/4.6.1

#---------------------------------------------------------------
# OpenMP defaults (per-run OMP_NUM_THREADS is set by exec.DELTA_CPU)
#---------------------------------------------------------------
export OMP_STACKSIZE=400M
export OMP_PLACES=cores
export OMP_PROC_BIND=close

# Large automatic arrays in cgyro; raise the stack limit where allowed.
ulimit -s unlimited 2> /dev/null || true

# Delta is not a Cray EX, so the MPICH_* family does not apply here.
# Uncomment only if UCX/OpenMPI complains about the Slingshot fabric:
#export OMPI_MCA_pml=ucx
