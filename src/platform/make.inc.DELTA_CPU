#---------------------------------------------------------------------
# NCSA Delta (login.delta.ncsa.illinois.edu) -- CPU partition
#
# Toolchain: HPE Cray PE -- PrgEnv-gnu (gcc-native) + cray-mpich
#            + cray-libsci (BLAS/LAPACK) + cray-fftw
#
# Delta has been a Cray PE machine since the 2025 RedHat 9 upgrade, so
# the build goes through the Cray wrappers (ftn/cc).  The wrappers add
# the include and link lines for cray-mpich, cray-libsci and cray-fftw
# themselves; do NOT add -lopenblas/-llapack/-lblas or an MPI library.
#
# Hardware: 2 x AMD EPYC 7763 "Milan", 64 cores/socket @ 2.45 GHz,
#           256 GB DDR4 (~252 GB usable), NPS=4 -> 4 memory domains/socket.
#
# Usage:
#   export GACODE_ROOT=<top_of_cloned_repo>
#   export GACODE_PLATFORM=DELTA_CPU
#   source ${GACODE_ROOT}/platform/env/env.${GACODE_PLATFORM}
#   source ${GACODE_ROOT}/shared/bin/gacode_setup
#
# WARNING: gacode_qsub and gacode_mpi_tool parse this file with plain
# grep and 'export' whatever matches, so the three constants below must
# stay bare assignments and no other line -- comments included -- may
# repeat those variable-name fragments.
#---------------------------------------------------------------------

IDENTITY="NCSA Delta CPU"
CORES_PER_NODE=128
NUMAS_PER_NODE=8

# Cray compiler drivers.  ftn/cc already are the MPI compilers here.
MF90 = ftn
MCC  = cc

#---------------------------------------------------------------------
# Compilers and flags
#
# PrgEnv-gnu means ftn wraps gfortran, so the GNU flags apply.
# -fallow-argument-mismatch is required by gfortran >= 10 for the
# legacy-interface MPI/FFTW calls left in the tree.  It sits on the
# FC/F77 lines rather than in FOPT so that OPT=debug builds also work.
#---------------------------------------------------------------------

FC  = ${MF90} -std=f2008 -fall-intrinsics -fPIC -fallow-argument-mismatch -I ${GACODE_ROOT}/modules -J ${GACODE_ROOT}/modules
F77 = ${MF90} -std=legacy -fall-intrinsics -fallow-argument-mismatch
CC  = ${MCC}

FACC   =
FOMP   =-fopenmp
FMATH  =-fdefault-real-8 -fdefault-double-8
FOPT   =-O3 -march=znver3 -mtune=znver3 -funroll-loops
FDEBUG =-Wall -W -fcheck=all -g -fbacktrace -ffpe-trap=invalid,zero,overflow -finit-real=nan
FBOUND =-Wall -fbounds-check
F2PY   = f2py

# craype-x86-milan already targets znver3; the explicit -march above is
# the same value and keeps the build correct if that module is missing.
# Login and compute nodes are the same Milan parts, so it is safe.
# -Ofast is faster but changes results; only switch after a regression
# run against a known case.

#---------------------------------------------------------------------
# System math libraries.
#
# cray-libsci supplies BLAS + LAPACK and is linked by the ftn wrapper,
# so only the FFTW libraries are named here.  cray-fftw exports FFTW_DIR
# (lib) and FFTW_INC (include); '?=' falls back to FFTW_ROOT if a job
# forgot to load the module.
#
# CGYRO calls dfftw_*/sfftw_* only; GYRO also calls dfftw_init_threads.
# Link the threaded FFTW variant only if the module actually ships one.
#---------------------------------------------------------------------

FFTW_DIR ?= ${FFTW_ROOT}/lib
FFTW_INC ?= ${FFTW_ROOT}/include

FFTW_PAR = $(if $(wildcard ${FFTW_DIR}/libfftw3_threads.*),-lfftw3_threads -lfftw3f_threads,$(if $(wildcard ${FFTW_DIR}/libfftw3_omp.*),-lfftw3_omp -lfftw3f_omp,))

LMATH = ${FFTW_PAR} -lfftw3 -lfftw3f

# OPTIONAL NetCDF, needed by profiles_gen/tgyro but not by cgyro+tglf.
# Uncomment together with the cray-netcdf/cray-hdf5 module loads in env.
#NETCDF     = -lnetcdff -lnetcdf
#NETCDF_INC = ${NETCDF_DIR}/include

# Archive
ARCH = ar cr
