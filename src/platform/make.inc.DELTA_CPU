#---------------------------------------------------------------------
# NCSA Delta (login.delta.ncsa.illinois.edu) -- CPU partition
#
# Toolchain: GNU 11.4.0 + OpenMPI 4.1.6 + OpenBLAS + FFTW3
#
# Hardware: 2 x AMD EPYC 7763 "Milan", 64 cores/socket @ 2.45 GHz,
#           256 GB DDR4 (2 GB/core), NPS=4 -> 4 memory domains/socket.
#
# Usage:
#   export GACODE_ROOT=<top_of_cloned_repo>
#   export GACODE_PLATFORM=DELTA_CPU
#   source ${GACODE_ROOT}/platform/env/env.${GACODE_PLATFORM}
#   source ${GACODE_ROOT}/shared/bin/gacode_setup
#
# WARNING: gacode_qsub and gacode_mpi_tool parse this file with plain
# grep and 'export' whatever matches, so the three constants below must
# stay bare assignments and no other line -- comments included -- may
# repeat those variable-name fragments.
#---------------------------------------------------------------------

IDENTITY="NCSA Delta CPU"
CORES_PER_NODE=128
NUMAS_PER_NODE=8

MF90 = mpif90
MCC  = mpicc

#---------------------------------------------------------------------
# Library prefixes.
#
# Delta's Lmod tree is generated by Spack, which exports <PKG>_ROOT for
# each module and prepends PKG_CONFIG_PATH.  '?=' therefore keeps the
# module-provided value when it exists and falls back to pkg-config
# when it does not.  If both come up empty the link fails with '-L/lib':
# check 'module show fftw' / 'module show openblas' and hard-code below.
#---------------------------------------------------------------------

FFTW_ROOT     ?= $(shell pkg-config --silence-errors --variable=prefix fftw3)
OPENBLAS_ROOT ?= $(shell pkg-config --silence-errors --variable=prefix openblas)

# Spack uses lib/, some builds use lib64/; take whichever exists.
FFTW_LIB     = $(firstword $(wildcard ${FFTW_ROOT}/lib64 ${FFTW_ROOT}/lib) ${FFTW_ROOT}/lib)
OPENBLAS_LIB = $(firstword $(wildcard ${OPENBLAS_ROOT}/lib64 ${OPENBLAS_ROOT}/lib) ${OPENBLAS_ROOT}/lib)

# CGYRO calls dfftw_*/sfftw_* only; GYRO also calls dfftw_init_threads.
# Link the parallel FFTW variant only if the module actually ships one.
FFTW_PAR = $(if $(wildcard ${FFTW_LIB}/libfftw3_threads.*),-lfftw3_threads -lfftw3f_threads,$(if $(wildcard ${FFTW_LIB}/libfftw3_omp.*),-lfftw3_omp -lfftw3f_omp,))

#---------------------------------------------------------------------
# Compilers and flags
#
# -fallow-argument-mismatch is required by gfortran >= 10 for the
# legacy-interface MPI/FFTW calls left in the tree.  It sits on the
# FC/F77 lines rather than in FOPT so that OPT=debug builds also work.
#---------------------------------------------------------------------

FC  = ${MF90} -std=f2008 -fall-intrinsics -fPIC -fallow-argument-mismatch -I ${GACODE_ROOT}/modules -J ${GACODE_ROOT}/modules
F77 = ${MF90} -std=legacy -fall-intrinsics -fallow-argument-mismatch
CC  = ${MCC}

FACC   =
FOMP   =-fopenmp
FMATH  =-fdefault-real-8 -fdefault-double-8
FOPT   =-O3 -march=znver3 -mtune=znver3 -funroll-loops
FDEBUG =-Wall -W -fcheck=all -g -fbacktrace -ffpe-trap=invalid,zero,overflow -finit-real=nan
FBOUND =-Wall -fbounds-check
F2PY   = f2py

# Login and compute nodes are the same Milan parts, so -march=znver3 is
# safe.  -Ofast is faster but changes results; only switch after a
# regression run against a known case.

#---------------------------------------------------------------------
# System math libraries.  OpenBLAS ships a full LAPACK, so netlib-lapack
# is deliberately neither loaded nor linked.  rpath is baked in so the
# binaries still run if a batch job forgets to re-load the modules.
#---------------------------------------------------------------------

LMATH    = -L${OPENBLAS_LIB} -Wl,-rpath,${OPENBLAS_LIB} -lopenblas -L${FFTW_LIB} -Wl,-rpath,${FFTW_LIB} ${FFTW_PAR} -lfftw3 -lfftw3f
FFTW_INC = ${FFTW_ROOT}/include

# OPTIONAL NetCDF, needed by profiles_gen/tgyro but not by cgyro+tglf.
# Uncomment together with the netcdf-fortran/hdf5 module loads in env.
#NETCDF_FORTRAN_ROOT ?= $(shell pkg-config --silence-errors --variable=prefix netcdf-fortran)
#NETCDF_C_ROOT       ?= $(shell pkg-config --silence-errors --variable=prefix netcdf)
#NETCDF     = -L${NETCDF_FORTRAN_ROOT}/lib -lnetcdff -L${NETCDF_C_ROOT}/lib -lnetcdf
#NETCDF_INC = ${NETCDF_FORTRAN_ROOT}/include

# Archive
ARCH = ar cr
