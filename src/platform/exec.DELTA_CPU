#! /usr/bin/env bash
# GACODE Parallel execution script -- NCSA Delta (CPU partition)
#
# Delta runs the Cray PE with cray-mpich, which is launched exclusively
# through srun: NCSA does not provide mpirun on the system.

simdir=${1}
nmpi=${2}
exec=${3}
nomp=${4}
numa=${5}
mpinuma=${6}

# nmpi    = MPI tasks
# nomp    = OpenMP threads per MPI task
# numa    = NUMAs active per node
# mpinuma = MPI tasks per active NUMA

. $GACODE_ROOT/shared/bin/gacode_mpi_tool

cd $simdir

export OMP_NUM_THREADS=$nomp
export OMP_STACKSIZE=${OMP_STACKSIZE:-400M}
if [ "$nomp" -gt 1 ] ; then
   export OMP_PLACES=cores
   export OMP_PROC_BIND=close
fi

# cray-mpich settings: threads only call MPI from the master thread, and
# this is a CPU-only build so no GPU-aware path is needed.
export MPICH_MAX_THREAD_SAFETY=funneled
export MPICH_GPU_SUPPORT_ENABLED=0

export SLURM_CPU_BIND="cores"
ulimit -c unlimited
ulimit -s unlimited 2> /dev/null

echo "> srun --cpu-bind=cores -n $nmpi -c $nomp $exec"
srun --cpu-bind=cores -n $nmpi -c $nomp $exec
