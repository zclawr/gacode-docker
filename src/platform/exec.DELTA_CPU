#! /usr/bin/env bash
# GACODE Parallel execution script -- NCSA Delta (CPU partition)
#
# OpenMPI 4.1.6 launched through srun.  Delta is not a Cray machine, so
# no MPICH_* variables are set here.

simdir=${1}
nmpi=${2}
exec=${3}
nomp=${4}
numa=${5}
mpinuma=${6}

# nmpi    = MPI tasks
# nomp    = OpenMP threads per MPI task
# numa    = NUMAs active per node
# mpinuma = MPI tasks per active NUMA

. $GACODE_ROOT/shared/bin/gacode_mpi_tool

cd $simdir

export OMP_NUM_THREADS=$nomp
export OMP_STACKSIZE=${OMP_STACKSIZE:-400M}
if [ "$nomp" -gt 1 ] ; then
   export OMP_PLACES=cores
   export OMP_PROC_BIND=close
fi

export SLURM_CPU_BIND="cores"
ulimit -c unlimited
ulimit -s unlimited 2> /dev/null

# Set GACODE_MPI_LAUNCH=mpirun to bypass srun/PMIx.
launch=${GACODE_MPI_LAUNCH:-srun}

if [ "$launch" = "srun" ] && [ -n "$SLURM_JOB_ID" ] ; then

   opt="--cpu-bind=cores -n $nmpi -c $nomp"

   # OpenMPI bootstraps through PMIx under srun; ask for it explicitly
   # when this Slurm build offers it.
   if srun --mpi=list 2>&1 | grep -qi pmix ; then
      opt="--mpi=pmix $opt"
   fi

   echo "> srun $opt $exec"
   srun $opt $exec

else

   # Interactive / non-Slurm fallback.  PE=$nomp reserves $nomp cores
   # per rank and round-robins ranks over the two sockets.
   echo "> mpirun -np $nmpi --map-by socket:PE=$nomp --bind-to core $exec"
   mpirun -np $nmpi --map-by socket:PE=$nomp --bind-to core \
          -x OMP_NUM_THREADS -x OMP_STACKSIZE $exec

fi
